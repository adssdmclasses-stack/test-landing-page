{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/10th-class-coaching", "destination": "/10th-class-coaching-bhopal", "permanent": false },
    { "source": "/mp-board", "destination": "/mp-board-10th-coaching-bhopal", "permanent": false },
    { "source": "/cbse", "destination": "/cbse-class-10-coaching-bhopal", "permanent": false },
    { "source": "/maths-science", "destination": "/class-10-maths-science-coaching-bhopal", "permanent": false },
    { "source": "/crash-course", "destination": "/class-10-crash-course-bhopal", "permanent": false },
    { "source": "/near-me", "destination": "/class-10-tuition-near-me-bhopal", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer-when-downgrade" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
